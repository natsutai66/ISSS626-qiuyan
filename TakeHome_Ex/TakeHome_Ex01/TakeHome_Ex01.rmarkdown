##Loading the R packages

```{r}
pacman::p_load(tidyverse, sf, tmap, httr)
```

## Importing ACRA data

```{r}
folder_path <- "data/aspatial/acra"
file_list <- list.files(path = folder_path,
                        pattern = "^ACRA*.*\\.csv$",
                        full.names = TRUE)

acra_data <- file_list %>%
  map_dfr(read_csv)
```

## Saving ACRA data

```{r}
write_rds(acra_data,
          "data/rds/acra_data.rds")
```

## Tidying ACRA data

3 types of transport business are selected:
- 49102 (Mass rapid transit systems)
- 49211 (Public bus services)
- 49214 (Street-hail and ride-hail service providers)

```{r}
biz_transport <- acra_data %>%
  select(1:24) %>%
  filter(primary_ssic_code == 49102, 49211, 49214) %>%
  rename(date = registration_incorporation_date) %>%
  mutate(date = as.Date(date),
         YEAR = year(date),
         MONTH_NUM = month(date),
         MONTH_ABBR = month(date,
                            label = TRUE,
                            abbr = TRUE)) %>%
  mutate(
    postal_code = str_pad(postal_code, 
    width = 6, side = "left", pad = "0")) %>% 
           filter(YEAR == 2025)
```

## Geocoding

found: successfully geocoded not found: unsuccessfully geocoded

```{r}
postcodes <- unique(biz_transport$postal_code)

url <- "https://onemap.gov.sg/api/common/elastic/search"

found <- data.frame()
not_found <- data.frame(postcode = character())

for (pc in postcodes) {
  query <- list(
    searchVal = pc,
    returnGeom = "Y",
    getAddrDetails = "Y",
    pageNum = "1"
  )

  res <- GET(url, query = query)
  json <- content(res)
  
  if (json$found != 0) {
    df <- as.data.frame(json$results, stringsAsFactors = FALSE)
    df$input_postcode <- pc
    found <- bind_rows(found, df)
  } else {
    not_found <- bind_rows(not_found, data.frame(postcode = pc))
  }
}
```

## Tidying the geocoded data

```{r}
found <- found %>%
  select(1:10)
```

## Appending the location information

```{r}
biz_transport = biz_transport %>%
  left_join(found,
            by = c('postal_code' = 'POSTAL'))
```

## Saving the data

```{r}
write_rds(biz_transport, "data/rds/biz_transport.rds")
```

## Converting into SF data frame

```{r}
biz_transport_sf <- st_as_sf(biz_transport,
                         coords = c("X", "Y"),
                         crs = 3414)
```

## Visualising the distribution

```{r}
ggplot(data = biz_transport,
       aes(x = MONTH_ABBR)) +
  geom_bar()
```

## Visualising the business

```{r}
tmap_mode('view')
tm_shape(biz_transport_sf)+
  tm_dots()
```


